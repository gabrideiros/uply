{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uply",
  "version": "0.1.0",
  "identifier": "com.uply.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  
  "app": {
    "windows": [
      {
        "title": "uply",
        "width": 280,
        "height": 250,
        "fullscreen": false,
        "resizable": false,
        "visible": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "alwaysOnTop": true,
        "closable": false,
        "decorations": false,
        "minimizable": false,
        "theme": "Dark",
        "skipTaskbar": true, 
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
